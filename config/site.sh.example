#!/usr/bin/env bash
# Machine/site-specific software setup. Copy to config/site.sh and edit.
# This file is sourced by scripts/build.sh and is intentionally ignored by Git.

# Example: select one exact ROOT installation explicitly.
# source "/path/to/root/bin/thisroot.sh"
# export ROOT_DIR="$(root-config --prefix)/cmake"

# Example: optional Garfield++ built against that same ROOT installation.
# export GARFIELD_HOME="$HOME/local/garfield"
# export CMAKE_PREFIX_PATH="$GARFIELD_HOME:${CMAKE_PREFIX_PATH:-}"
# Configure it with: cmake --preset default -DANALYSIS_WITH_GARFIELD=ON

# Shared clusters can place their module commands here instead.
# module purge
# module load gcc root
